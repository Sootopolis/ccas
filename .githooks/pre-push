#!/usr/bin/env bash
# Skip the test run when every ref being pushed is a deletion. Git feeds
# `<local-ref> <local-sha> <remote-ref> <remote-sha>` lines on stdin; a
# deletion has local-sha = 0000000000000000000000000000000000000000.
zero=0000000000000000000000000000000000000000
all_deletes=1
saw_any=0
while read local_ref local_sha remote_ref remote_sha; do
  saw_any=1
  if [ "$local_sha" != "$zero" ]; then
    all_deletes=0
  fi
done

if [ "$saw_any" = 1 ] && [ "$all_deletes" = 1 ]; then
  echo "Pre-push: delete-only push, skipping tests."
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then
  echo "Testing the documentation checker, then checking the documentation standard..."
  python3 scripts/test_check_docs.py || exit 1
  python3 scripts/check-docs.py || exit 1
else
  echo "Pre-push: python3 not found, skipping the documentation check."
fi

echo "Checking formatting and the coding conventions, then running the tests before push..."
# One argument, `;`-separated: sbt's thin client (SBT_NATIVE_CLIENT=true) joins separate arguments into one command.
sbt "lint; test"
