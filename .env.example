# This .env is auto-sourced only for `sbt run`. The packaged `ccas` / `ccas-server` binaries read the process
# environment instead — for those, prefer `ccas config init`, which writes ~/.config/ccas/ccas.env (0600) that the
# server applies at boot. Process env still overrides that file. See README → Configuration → Server config file.

CCAS_CONTACT_EMAIL=your-email@example.com

# These match the docker-compose service as shipped. DB_USER/DB_NAME are also hardcoded in
# src/test/resources/application.conf (user `ccas`, database `ccas_test`), so changing them means changing that
# too. DB_PORT is what docker-compose publishes on, so bumping it moves the container and the app together.
DB_USER=ccas
DB_PASSWORD=ccas
DB_NAME=ccas
DB_PORT=5432
DB_HOST=localhost
DB_SCHEMA=public

# Database URL — if set, takes priority over individual dataSource fields above.
# Either form is accepted: the JDBC one, or the libpq URI providers hand out (it is
# converted at boot, credentials lifted out of the URL — PostgresClient.normalizeJdbcUrl).
# DATABASE_URL=jdbc:postgresql://host/db?user=x&password=x&sslmode=require
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional overrides (defaults shown)
# SERVER_PORT=8080
# SCHEDULER_POLL_MINUTES=15
# Boot-seed defaults for the global MatchRef / ClubData maintenance schedules (seed-only; edit live rows via `ccas schedule`)
# SCHEDULER_MATCHREF_INTERVAL_HOURS=24
# SCHEDULER_MATCHREF_ENABLED=true
# SCHEDULER_CLUBDATA_INTERVAL_HOURS=6
# SCHEDULER_CLUBDATA_ENABLED=true
# DB_POOL_MAX=20
# DB_POOL_MIN_IDLE=2
# DB_POOL_CONNECTION_TIMEOUT=30000
# DB_POOL_IDLE_TIMEOUT=600000
# DB_POOL_MAX_LIFETIME=1800000
# DB_POOL_KEEPALIVE_TIME=120000
# CHESS_COM_API_RECOVERY_TIERS=2,4,6,8
# CHESS_COM_API_COOLDOWN_SECONDS=15
# CHESS_COM_API_CF_COOLDOWN_SECONDS=30
# CHESS_COM_API_FAILURE_WINDOW_SIZE=40
# CHESS_COM_API_FAILURE_THRESHOLD=0.2
# CHESS_COM_API_MIN_SAMPLE_SIZE=15
# CHESS_COM_API_MIN_REQUEST_DELAY_MS=75
# CHESS_COM_API_MIN_TIER_OBSERVATION_SECONDS=10
# CHESS_COM_API_RETRY_BASE_SECONDS=1
# CHESS_COM_API_CF_RETRY_DELAY_SECONDS=10
# CHESS_COM_API_CONNECTION_RETRY_BASE_SECONDS=1
# CHESS_COM_API_MAX_429_RETRIES=5
# CHESS_COM_API_MAX_CF_RETRIES=2
# CHESS_COM_API_MAX_CONNECTION_RETRIES=3
# CHESS_COM_API_STATS_FLUSH_INTERVAL_SECONDS=30

# Cache retention is DB-owned, not env-tunable: see app_setting.cache_retention_days (compiled default 7 days).

# Where cached Chess.com response *bodies* are stored (#191). Only the blobs move — the api_response_cache
# metadata index always stays in Postgres.
#   fs (default) — local disk, zero config. Defaults to ${XDG_CACHE_HOME:-$HOME/.cache}/ccas/bodies; set
#                  CCAS_BODY_STORE_FS_ROOT to override (an absolute path — a relative one resolves against
#                  whatever directory the process was launched from, and is warned about at startup).
#   s3           — any S3-compatible endpoint; used against Cloudflare R2, whose egress is free. Requires the
#                  endpoint, bucket and credentials below. Keep the two keys out of this file in favour of
#                  `ccas config set` (0600, redacted by `ccas config list`).
# CCAS_BODY_STORE_BACKEND=fs
# CCAS_BODY_STORE_FS_ROOT=/var/lib/ccas/bodies
# CCAS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CCAS_R2_BUCKET=ccas
# CCAS_R2_REGION=auto
# CCAS_R2_ACCESS_KEY=
# CCAS_R2_SECRET_KEY=

# Backups (scripts/backup-neon.sh)
# CCAS_BACKUP_DIR=~/ccas-backups
# CCAS_BACKUP_RETAIN=6
