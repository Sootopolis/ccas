DB_USER=ccas
DB_PASSWORD=changeme
DB_NAME=ccas
DB_PORT=5432
DB_HOST=localhost
DB_SCHEMA=public

# JDBC URL — if set, takes priority over individual dataSource fields above.
# DATABASE_URL=jdbc:postgresql://host/db?user=x&password=x&sslmode=require

# Optional overrides (defaults shown)
# SERVER_PORT=8080
# SCHEDULER_POLL_MINUTES=5
# DB_POOL_MAX=20
# DB_POOL_MIN_IDLE=2
# CHESS_COM_API_RECOVERY_TIERS=2,4,6,8
# CHESS_COM_API_COOLDOWN_SECONDS=15
# CHESS_COM_API_CF_COOLDOWN_SECONDS=30
# CHESS_COM_API_FAILURE_WINDOW_SIZE=40
# CHESS_COM_API_FAILURE_THRESHOLD=0.2
# CHESS_COM_API_MIN_SAMPLE_SIZE=15
# CHESS_COM_API_MIN_REQUEST_DELAY_MS=75
# CHESS_COM_API_MIN_TIER_OBSERVATION_SECONDS=10
# CHESS_COM_API_RETRY_BASE_SECONDS=1
# CHESS_COM_API_CF_RETRY_DELAY_SECONDS=10
# CHESS_COM_API_CONNECTION_RETRY_BASE_SECONDS=1
# CHESS_COM_API_MAX_429_RETRIES=5
# CHESS_COM_API_MAX_CF_RETRIES=2
# CHESS_COM_API_MAX_CONNECTION_RETRIES=3
